{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "installCommand": "npm install --legacy-peer-deps",
        "buildCommand": "npm run build"
      }
    },
    {
      "src": "backend-Node/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["backend-Node/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend-Node/index.js"
    },
    {
      "src": "/job-recommendations(.*)",
      "dest": "/backend-Node/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/(favicon\\..*|vite\\.svg|robots\\.txt|.*\\.(?:png|jpg|jpeg|gif|svg|ico|json|woff2?|ttf|eot))",
      "dest": "/frontend/$1"
    },
    {
      "src": "/frontend/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
